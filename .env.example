# GitHub 自动推送配置示例
# 请复制此文件为 .env 并填入真实凭证

# GitHub 个人访问令牌 (PAT)
# 生成方式: GitHub Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# 所需权限: repo (完整仓库访问权限)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub 用户名
GITHUB_USERNAME=your_username

# 可选: 配置 Git 用户信息 (如果尚未配置)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email@example.com
